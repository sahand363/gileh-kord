# Server Network Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

# Optional TLS / HTTPS Configuration
# Leave empty to run in plain HTTP mode (for local network or direct IP access).
# Provide both paths to enable HTTPS.
TLS_CERT_FILE=
TLS_KEY_FILE=

# SQLite Database Configuration
DATABASE_PATH=./data/gileh_kord.db
DATABASE_BUSY_TIMEOUT=5000
MIGRATIONS_PATH=./migrations

# Business Timezone & Reporting Currency (TOMAN or RIAL)
# Canonical storage is always integer TOMAN (1 TOMAN = 10 RIAL for display only).
TIMEZONE=Asia/Tehran
REPORTING_CURRENCY=TOMAN

# Explicit CORS Allowed Origins (Comma-separated; do not use * with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://94.184.6.138,https://gilehkord.modesehramiz.ir
